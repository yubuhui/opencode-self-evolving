{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "Clear-Item*": "ask",
      "Move-Item*": "ask",
      "Remove-Item*": "ask",
      "del *": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "rd *": "ask",
      "rm *": "ask",
      "rmdir *": "ask"
    }
  }
}
